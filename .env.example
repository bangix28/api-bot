# Modèle du .env de dev local (Docker). `make setup` le copie en .env et
# génère APP_SECRET / JWT_PASSPHRASE. Ne jamais y mettre de secret de prod.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_DEBUG=1
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://root:@mysql:3306/apibot?serverVersion=9.0.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://localhost:?[0-9]*$'
###< nelmio/cors-bundle ###

# Clé de dev Riot (https://developer.riotgames.com) — expire toutes les 24 h
RIOT_API_TOKEN=a-renseigner

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

# Port exposé par le conteneur nginx (lu par docker compose) — ex. 8000 si
# Apache ou un autre serveur occupe déjà le 80 sur le poste
NGINX_PORT=80
